# Copy to `.env` (repo root) and fill in real values — used by
# docker-compose.full.yml, which brings up this app alongside a self-hosted
# Supabase stack (docker/, set up separately — see docker-compose.full.yml's
# header comment and README's "Full Stack" section).

SITE_URL=http://localhost:3000

# Must exactly match ANON_KEY / SERVICE_ROLE_KEY in docker/.env — same JWTs,
# shared by Supabase's own gateway (Kong) and by this app.
SUPABASE_PUBLISHABLE_KEY=
SERVICE_ROLE_KEY=

# Web Push (VAPID) — generate with `npx web-push generate-vapid-keys`
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT_EMAIL=you@example.com

# Email (Resend, or any SMTP-compatible provider)
RESEND_API_KEY=
EMAIL_FROM=Your App <noreply@example.com>
