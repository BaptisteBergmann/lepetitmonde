# Copy to `.env.local` (repo root) and fill in real values.
# Only needed if you're not using mise — see mise.toml.example for the
# equivalent (and the extra tasks it wires up: db push, docker build, etc).

# --- Supabase (server-only, no NEXT_PUBLIC_ prefix — never sent to the browser) ---
SUPABASE_URL=http://localhost:8000
SUPABASE_PUBLISHABLE_KEY=
SERVICE_ROLE_KEY=

# --- App (server-only — used to build invite/auth-redirect links, never sent to the browser) ---
SITE_URL=http://localhost:3000

# --- Web Push (VAPID, server-only — sent to the browser via a server action, not inlined) —
# generate with `npx web-push generate-vapid-keys` ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT_EMAIL=you@example.com

# --- Email (Resend, or any SMTP-compatible provider) ---
RESEND_API_KEY=
EMAIL_FROM=Your App <noreply@example.com>
